{
  "version": 1,
  "defaults": {
    "max_iterations": 5,
    "max_fix_attempts": 2,
    "preflight_fix_attempts": 2,
    "full_gate_every": 5,
    "auto_push": false,
    "branch_prefix": "codex/auto-harness",
    "light_gate_command": "python harness-engine/.dev-harness/checks/dev_gate.py --SkipRust --Fast",
    "full_gate_command": "python harness-engine/.dev-harness/checks/dev_gate.py --SkipRust"
  },
  "providers": {
    "gpt5_planner_reviewer": {
      "env": {
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_API_KEY": "replace-me",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_ATTRIBUTION_HEADER": "0"
      },
      "headers": {
        "x-openai-proxy": {
          "env": "OPENAI_API_KEY"
        }
      },
      "model_env": "OPENAI_MODEL",
      "model": "gpt-5.5"
    },
    "glm_executor": {
      "env": {
        "ANTHROPIC_BASE_URL": "https://example.invalid/anthropic",
        "ANTHROPIC_AUTH_TOKEN": "replace-me",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_ATTRIBUTION_HEADER": "0"
      },
      "headers": {
        "x-claude-proxy": {
          "env": "ANTHROPIC_AUTH_TOKEN"
        }
      },
      "model_env": "ANTHROPIC_MODEL",
      "model": "glm-5.1"
    }
  },
  "roles": {
    "task_writer": {
      "provider": "gpt5_planner_reviewer",
      "health_command": "claude --help",
      "command": "claude",
      "args": [
        "--print",
        "--verbose",
        "--output-format",
        "stream-json",
        "--dangerously-skip-permissions",
        "--allowed-tools",
        "Bash,Edit,Read,Write,Glob,Grep"
      ]
    },
    "implementer": {
      "provider": "glm_executor",
      "health_command": "claude --help",
      "command": "claude",
      "args": [
        "--print",
        "--verbose",
        "--output-format",
        "stream-json",
        "--dangerously-skip-permissions",
        "--allowed-tools",
        "Bash,Edit,Read,Write,Glob,Grep"
      ]
    },
    "preflight": {
      "provider": "glm_executor",
      "health_command": "claude --help",
      "command": "claude",
      "args": [
        "--print",
        "--verbose",
        "--output-format",
        "stream-json",
        "--dangerously-skip-permissions",
        "--allowed-tools",
        "Bash,Edit,Read,Write,Glob,Grep"
      ]
    }
  }
}
