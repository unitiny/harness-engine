# ============================================================
# harness-engine .gitignore
# Protects secrets, personal info, and generated artifacts.
# Only example/template files are tracked for sensitive configs.
# ============================================================

# --- Secrets & Credentials (use *.example.* files instead) ---
.dev-harness/automation/agent-config.json
acceptance/config/env.yaml

# --- Claude Code local settings ---
.claude/

# --- Harness automation/execution artifacts ---
.dev-harness/automation/agent-config.json
.dev-harness/automation/auto_state.json
.dev-harness/automation/program-state.json
.dev-harness/automation/receipts/
.dev-harness/automation/epics/**/execution-receipt-*.md
.dev-harness/execution-receipts/
.dev-harness/receipts/
.dev-harness/reviews/
.dev-harness/task-briefs/
.dev-harness/memory/
.dev-harness/tmp/
.dev-harness/templates/acceptance-gate-before.json
.dev-harness/templates/memorify.json

# --- Acceptance & Evaluation artifacts ---
acceptance/config/env.yaml
acceptance/reports/
.acceptance/

# --- Meta-harness runtime artifacts ---
meta-harness/evidence-packets/
meta-harness/experience/
meta-harness/logs/
meta-harness/proposals/candidate/
meta-harness/proposals/validated/
meta-harness/proposals/rejected/
meta-harness/replays/
meta-harness/reports/
meta-harness/semantic-reviews/
meta-harness/signals/

# --- My Video artifacts (if not the main project) ---
my-video/screenshots/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Build output ---
my-video/presentation/dist/

# --- User screenshots & media ---
my-video/screenshots/

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- Environment files ---
.env
.env.*
!.env.example