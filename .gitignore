# ============================================================
# harness-engine .gitignore
# Protects secrets, personal info, and generated artifacts.
# Only example/template files are tracked for sensitive configs.
# ============================================================

# --- Secrets & Credentials (use *.example.* files instead) ---
.dev-harness/automation/agent-config.json
acceptance/config/env.yaml

# --- Claude Code local settings ---
.claude/

# --- My Video artifacts (if not the main project) ---
my-video/screenshots/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Build output ---
my-video/presentation/dist/

# --- User screenshots & media ---
my-video/screenshots/

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- Environment files ---
.env
.env.*
!.env.example